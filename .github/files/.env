# Pimcore API Test Environment — Configuration
# Service credentials, ports and image versions.
# Secrets (tokens, product registration) are passed via CLI args or CI secrets.

# Docker image versions
PHP_IMAGE=pimcore/pimcore:php8.5-max-5.x
PHP_SUPERVISORD_IMAGE=pimcore/pimcore:php8.5-supervisord-5.x

# Host user/group for Docker containers (prevents permission issues with mounted volumes)
# 00-localsetup.sh auto-detects these from the host at runtime
DOCKER_UID=1000
DOCKER_GID=1000

# Pimcore composer repository URLs
PIMCORE_REPO_URL=https://repo.pimcore.com/pimcore-developers/
PIMCORE_REPO_URL_CI=https://repo.pimcore.com/github-actions/

# Exposed ports (local development)
NGINX_PORT=8088
OPENSEARCH_DASHBOARDS_PORT=5601
MAILPIT_PORT=8025
MERCURE_PORT=8080
DB_PORT=3307

# Pimcore install settings
PIMCORE_ADMIN_USER=admin
PIMCORE_ADMIN_PASSWORD=admin

# Database
MYSQL_ROOT_PASSWORD=ROOT
MYSQL_DATABASE=pimcore
MYSQL_USER=pimcore
MYSQL_PASSWORD=pimcore

# OpenSearch
OPENSEARCH_INITIAL_ADMIN_PASSWORD=gBsVe!Dut723

# Application
APP_ENV=dev
APP_DEBUG=true
APPLICATION_SECRET=api_test_secret_key_not_for_production
APPLICATION_ENCRYPTION_SECRET=api_test_encryption_key_not_for_prod
